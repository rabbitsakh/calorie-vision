generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WeightGoal {
  LOSE
  GAIN
  MAINTAIN
}

enum GoalPace {
  SIMPLE
  HEALTHY
  FAST
}

enum Sex {
  FEMALE
  MALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  phone         String?        @unique
  phoneVerified DateTime?
  image         String?
  sex           Sex?
  heightCm      Int?
  birthYear     Int?
  /** Daily activity for TDEE; null → LIGHT (1.25), same as legacy hardcoded factor. */
  activityLevel ActivityLevel?
  goal          WeightGoal?
  goalPace      GoalPace?
  targetWeightKg Float?
  goalDeadline   String?        @db.VarChar(10)
  /** Soft daily fiber goal override (g); null → diet default (~28). */
  fiberTargetG  Float?
  /** Soft free-sugar cap override (g); null → diet default (~10% energy). */
  sugarTargetG  Float?
  /** Personal daily water goal (ml); null → 2000. */
  waterTargetMl Int?
  /** Opt-in weekly email digest (Sunday/Monday cron). */
  weeklyDigestEmail Boolean @default(false)
  timezone      String?        @db.VarChar(64)
  /** Opaque invite code (HMAC-derived); unique for ?ref= lookup. */
  referralCode  String?        @unique @db.VarChar(16)
  /** User who invited this account via ?ref= (set once). */
  referredByUserId String?     @db.VarChar(191)
  referralClaimedAt DateTime?
  /** Soft allergen tags for confirm warnings (JSON string[]). */
  allergensJson Json?
  /** Local hour (0–23) when quiet hours begin; null = disabled. */
  quietHoursStart Int?
  /** Local hour (0–23) when quiet hours end (exclusive); null = disabled. */
  quietHoursEnd   Int?
  /** Local hour (0–23) when eating window begins; null = fasting UI off. */
  fastingStartHour Int?
  /** Local hour (0–23) when eating window ends (exclusive); null = off. */
  fastingEndHour   Int?
  /** Per-kind push reminder toggles/hours; null → quiet first-run defaults. */
  pushReminderPrefs Json?
  /** Equipped collection frame key (synced across devices). */
  equippedFrameKey   String? @db.VarChar(64)
  /** Equipped diary sticker key (synced across devices). */
  equippedStickerKey String? @db.VarChar(64)
  /** Equipped mascot cheer phrase key (synced across devices). */
  equippedCheerKey   String? @db.VarChar(64)
  accounts      Account[]
  sessions      Session[]
  mealEntries   MealEntry[]
  weightEntries WeightEntry[]
  waterEntries  WaterEntry[]
  diaryNotes    DiaryNote[]
  customFoods   CustomFood[]
  dayTemplates  DayTemplate[]
  shoppingList  ShoppingList?
  streakFreezes StreakFreeze[]
  pushSubscriptions PushSubscription[]
  pushReminderLogs  PushReminderLog[]
  challenges    UserChallenge[]
  userBadges    UserBadge[]
  userRewards   UserReward[]
  workoutSessions          WorkoutSession[]
  workoutExerciseLibrary   WorkoutExerciseLibrary[]
  workoutRoutines          WorkoutRoutine[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


/** Server-synced day meal templates (payload = meals JSON). */
model DayTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(120)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


/** Server-synced shopping list (items JSON array). */
model ShoppingList {
  id        String   @id @default(cuid())
  userId    String   @unique
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WeightEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   @db.VarChar(10)
  weightKg    Float
  note        String?  @db.VarChar(200)
  measuredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, measuredAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealEntry {
  id                 String    @id @default(cuid())
  userId             String
  date               String    @db.VarChar(10)
  dishName           String
  calories           Int
  protein            Float?
  fat                Float?
  carbs              Float?
  fiber              Float?
  sugar              Float?
  portionGrams       Int?
  confidence         Float?
  imagePath          String?
  mealGroupId        String?   @db.VarChar(191)
  mealType           MealType?
  wasCorrected       Boolean   @default(false)
  originalDish       String?
  originalCalories   Int?
  recognitionSource  String?   @db.VarChar(64)
  photoKind          String?   @db.VarChar(32)
  barcode            String?   @db.VarChar(32)
  /** User-editable meal time; null → display createdAt. */
  eatenAt            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
  @@index([recognitionSource])
}

model RecognitionPassLog {
  id                 String   @id @default(cuid())
  pass               String   @db.VarChar(16)
  photoKind          String?  @db.VarChar(32)
  retryReason        String?  @db.VarChar(32)
  specialistPass     String?  @db.VarChar(16)
  promptVariant      String?  @db.VarChar(24)
  itemCount          Int      @default(0)
  calories           Int      @default(0)
  confidence         Float    @default(0)
  dishName           String?  @db.VarChar(80)
  source             String?  @db.VarChar(64)
  chatCalls          Int?
  latencyMs          Int?
  enrichmentTimedOut Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([pass])
}

model RecognitionConfig {
  id                     String   @id @default("default")
  lowConfidenceThreshold Float    @default(0.55)
  updatedAt              DateTime @updatedAt
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   @db.VarChar(10)
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CustomFood {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Int
  protein      Float?
  fat          Float?
  carbs        Float?
  fiber        Float?
  sugar        Float?
  portionGrams Int?
  useCount     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiaryNote {
  id        String   @id @default(cuid())
  userId    String
  date      String   @db.VarChar(10)
  note      String   @db.VarChar(500)
  mood      Int?     // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model StreakFreeze {
  id        String   @id @default(cuid())
  userId    String
  date      String   @db.VarChar(10)
  weekStart String   @db.VarChar(10)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@unique([userId, weekStart])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model PushReminderLog {
  id     String   @id @default(cuid())
  userId String
  kind   String   @db.VarChar(32)
  date   String   @db.VarChar(10)
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, date])
  @@index([userId, date])
}

model UserChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeKey String  @db.VarChar(64)
  weekStart   String   @db.VarChar(10)
  progress    Int      @default(0)
  target      Int
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeKey   String   @db.VarChar(64)
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
}

/** Cosmetic loot from chests (challenge / streak). One grant per sourceKey. */
model UserReward {
  id         String   @id @default(cuid())
  userId     String
  rewardKey  String   @db.VarChar(64)
  /** e.g. challenge | streak */
  source     String   @db.VarChar(32)
  /** e.g. weekStart-challengeKey or streak:14 */
  sourceKey  String   @db.VarChar(96)
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId])
  @@index([userId, rewardKey])
}

model FoodCorrection {
  id            String   @id @default(cuid())
  /** Empty string = legacy/global shared corrections; otherwise scoped to a user. */
  userId        String   @default("") @db.VarChar(191)
  originalKey   String   @db.VarChar(191)
  correctedName String
  calories      Int
  protein       Float?
  fat           Float?
  carbs         Float?
  fiber         Float?
  sugar         Float?
  portionGrams  Int?
  useCount      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, originalKey])
  @@index([userId])
}

/** Admin-only strength log (not exposed in public chrome / landing). */
/** Per-user exercise catalog for autocomplete (name + kind + default group). */
model WorkoutExerciseLibrary {
  id                 String   @id @default(cuid())
  userId             String
  name               String   @db.VarChar(120)
  /** normalizeExerciseName(name) for unique lookup. */
  nameNorm           String   @db.VarChar(120)
  /** strength | cardio | bodyweight | duration | weighted_bw | assisted */
  kind               String   @default("strength") @db.VarChar(16)
  defaultMuscleGroup String?  @db.VarChar(32)
  useCount           Int      @default(0)
  lastUsedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nameNorm])
  @@index([userId, lastUsedAt])
  @@index([userId, nameNorm])
}

/** Named routine / template («Push A», «Бег 5к») → start session in one tap. */
model WorkoutRoutine {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(120)
  note      String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  /**
   * Weekday schedule for the plan tab: 0=Mon … 6=Sun (JSON number[]).
   * Empty / null = not on the weekly plan.
   */
  weekdays  Json?
  /** Optional letter slot on the plan: A / B / C … */
  planLabel String?  @db.VarChar(8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscles   WorkoutRoutineMuscle[]
  exercises WorkoutRoutineExercise[]

  @@index([userId, sortOrder])
}

model WorkoutRoutineMuscle {
  id        String @id @default(cuid())
  routineId String
  /** Key from MUSCLE_GROUPS. */
  groupKey  String @db.VarChar(32)

  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, groupKey])
  @@index([groupKey])
}

model WorkoutRoutineExercise {
  id          String @id @default(cuid())
  routineId   String
  name        String @db.VarChar(120)
  /** strength | cardio | bodyweight | duration | weighted_bw | assisted */
  kind        String @default("strength") @db.VarChar(16)
  muscleGroup String? @db.VarChar(32)
  sortOrder   Int    @default(0)
  /**
   * Optional planned sets JSON:
   * [{ weightKg?, reps?, distanceKm?, durationSec?, setType? }]
   */
  plannedSets Json?
  /** Shared key (A/B/C…) — exercises with the same key form a superset/circuit. */
  supersetGroup String? @db.VarChar(8)
  /** normal | circuit | rest_pause */
  blockMode     String  @default("normal") @db.VarChar(16)
  circuitRounds Int?

  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, sortOrder])
}

model WorkoutSession {
  id           String    @id @default(cuid())
  userId       String
  date         String    @db.VarChar(10)
  note         String?   @db.VarChar(200)
  /** Target overload vs previous matching session (e.g. 0.05 = +5%). */
  progressRate Float     @default(0.05)
  /** Live session clock (null = never started / backfill). */
  startedAt    DateTime?
  endedAt      DateTime?
  /** When non-null, session clock is paused at this instant. */
  pausedAt     DateTime?
  /** Accumulated pause duration in milliseconds. */
  pausedMs     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscles   WorkoutSessionMuscle[]
  exercises WorkoutExercise[]

  @@index([userId, date])
  @@index([userId, createdAt])
}

model WorkoutSessionMuscle {
  id        String @id @default(cuid())
  sessionId String
  /** Key from MUSCLE_GROUPS (chest, back, …). */
  groupKey  String @db.VarChar(32)

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, groupKey])
  @@index([groupKey])
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  sessionId   String
  name        String   @db.VarChar(120)
  /** strength | cardio | bodyweight | duration | weighted_bw | assisted — drives set fields. */
  kind        String   @default("strength") @db.VarChar(16)
  /** Optional primary group; null → inherit session groups for load split. */
  muscleGroup String?  @db.VarChar(32)
  note        String?  @db.VarChar(200)
  sortOrder   Int      @default(0)
  /** Shared key (A/B/C…) — same key = superset/circuit within the session. */
  supersetGroup String? @db.VarChar(8)
  /** normal | circuit | rest_pause — live block structure. */
  blockMode     String  @default("normal") @db.VarChar(16)
  /** Target rounds when blockMode=circuit (shared across superset group). */
  circuitRounds Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@index([sessionId, sortOrder])
}

model WorkoutSet {
  id          String   @id @default(cuid())
  exerciseId  String
  /** Strength sets: kg × reps. Null for cardio. */
  weightKg    Float?
  reps        Int?
  /** Cardio segments: distance (km) and duration (seconds). */
  distanceKm  Float?
  durationSec Int?
  /** warmup | working | drop | failure | rest_pause */
  setType     String   @default("working") @db.VarChar(16)
  /** Marked done in the live log (starts rest timer). */
  completed   Boolean  @default(true)
  /** Rate of perceived exertion 1–10. */
  rpe         Float?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercise WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, sortOrder])
}
