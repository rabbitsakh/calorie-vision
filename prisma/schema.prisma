generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WeightGoal {
  LOSE
  GAIN
  MAINTAIN
}

enum GoalPace {
  SIMPLE
  HEALTHY
  FAST
}

enum Sex {
  FEMALE
  MALE
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  phone         String?        @unique
  phoneVerified DateTime?
  image         String?
  sex           Sex?
  heightCm      Int?
  birthYear     Int?
  goal          WeightGoal?
  goalPace      GoalPace?
  targetWeightKg Float?
  goalDeadline   String?        @db.VarChar(10)
  timezone      String?        @db.VarChar(64)
  accounts      Account[]
  sessions      Session[]
  mealEntries   MealEntry[]
  weightEntries WeightEntry[]
  waterEntries  WaterEntry[]
  diaryNotes    DiaryNote[]
  customFoods   CustomFood[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WeightEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String   @db.VarChar(10)
  weightKg    Float
  measuredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, measuredAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealEntry {
  id               String    @id @default(cuid())
  userId           String
  date             String    @db.VarChar(10)
  dishName         String
  calories         Int
  protein          Float?
  fat              Float?
  carbs            Float?
  portionGrams     Int?
  confidence       Float?
  imagePath        String?
  mealGroupId      String?   @db.VarChar(191)
  mealType         MealType?
  wasCorrected     Boolean   @default(false)
  originalDish     String?
  originalCalories Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   @db.VarChar(10)
  ml        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CustomFood {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Int
  protein      Float?
  fat          Float?
  carbs        Float?
  portionGrams Int?
  useCount     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiaryNote {
  id        String   @id @default(cuid())
  userId    String
  date      String   @db.VarChar(10)
  note      String   @db.VarChar(500)
  mood      Int?     // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model FoodCorrection {
  id            String   @id @default(cuid())
  originalKey   String   @unique @db.VarChar(191)
  correctedName String
  calories      Int
  protein       Float?
  fat           Float?
  carbs         Float?
  portionGrams  Int?
  useCount      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
