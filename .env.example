DATABASE_URL="mysql://calorie:password@localhost:3306/calorie_vision"
UPLOAD_DIR="public/uploads"

# Локально через Apache: /calorie-vision
# На продакшене (calorievision.ru): оставьте пустым
NEXT_PUBLIC_BASE_PATH=

# NextAuth
NEXTAUTH_SECRET=сгенерируйте-случайную-строку
# Канонический URL сайта без /api/auth
NEXTAUTH_URL=https://calorievision.ru

# Email (magic link) — нужен nodemailer (уже в зависимостях) + SMTP
# Вариант A: connection string (спецсимволы в пароле URL-кодируйте: @ → %40)
# Пример: smtp://user:pass@smtp.yandex.ru:465
EMAIL_SERVER=
# Вариант B: отдельные поля (удобнее, если в пароле есть @ : /)
# EMAIL_SERVER_HOST=smtp.yandex.ru
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=noreply@calorievision.ru
# EMAIL_SERVER_PASSWORD=
# EMAIL_SERVER_SECURE=1
EMAIL_FROM=noreply@calorievision.ru

# Telegram Login Widget — https://core.telegram.org/widgets/login
# 1) Создайте бота у @BotFather, /setdomain → calorievision.ru
# 2) Username и токен (для входа на /login, не chat-бот)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CalorieVisionAppBot
TELEGRAM_BOT_TOKEN=
# OIDC (вход с телефоном): BotFather → Login Widget → Client ID / Client Secret.
# Callback URL: https://calorievision.ru/api/auth/telegram/callback
# TELEGRAM_CLIENT_ID=   # обычно id бота (до «:» в токене); можно не задавать
TELEGRAM_CLIENT_SECRET=
# Если oauth.telegram.org недоступен с VPS (блокировка): SOCKS5/HTTP прокси для OIDC curl-фолбэка
# Если oauth.telegram.org недоступен с VPS: TELEGRAM_HTTPS_PROXY=socks5://127.0.0.1:1080

# Google OAuth (опционально)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VK ID (опционально) — https://id.vk.com/about/business/go
# Redirect URL в кабинете: https://calorievision.ru/api/auth/callback/vk
# VK_CLIENT_SECRET — сервисный ключ приложения
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# GigaChat (Сбер) — распознавание фото еды
GIGACHAT_CREDENTIALS=ваш-ключ-авторизации-base64
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_API_BASE=https://api.giga.chat/v1

# Яндекс Метрика — id счётчика из https://metrika.yandex.ru
# На сервере: YANDEX_METRIKA_ID=12345678 (подхватывается при next build)
YANDEX_METRIKA_ID=
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Web Push (PWA напоминания) — сгенерируйте: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@calorievision.ru

# Секрет для cron-эндпоинтов (Authorization: Bearer ...)
# /api/cron/reminders — каждый час: 0 * * * *
# /api/cron/weekly-digest — раз в неделю (пн): 0 7 * * 1
# curl -H "Authorization: Bearer $CRON_SECRET" "https://calorievision.ru/api/cron/reminders"
# curl -H "Authorization: Bearer $CRON_SECRET" "https://calorievision.ru/api/cron/weekly-digest"
# dry-run: ...?dryRun=1
CRON_SECRET=
