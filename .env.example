DATABASE_URL="mysql://calorie:password@localhost:3306/calorie_vision"
UPLOAD_DIR="public/uploads"

# Локально через Apache: /calorie-vision
# На продакшене (calorievision.ru): оставьте пустым
NEXT_PUBLIC_BASE_PATH=

# NextAuth
NEXTAUTH_SECRET=сгенерируйте-случайную-строку
# Локально:
# NEXTAUTH_URL=http://localhost:3000/calorie-vision/api/auth
# Продакшен:
NEXTAUTH_URL=https://calorievision.ru/api/auth

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
APPLE_ID=
APPLE_SECRET=

# GigaChat (Сбер) — распознавание фото еды
# Вариант 1: ключ авторизации (Base64) из личного кабинета
GIGACHAT_CREDENTIALS=ваш-ключ-авторизации-base64
# Вариант 2: Client ID + Client Secret отдельно
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_API_BASE=https://api.giga.chat/v1
